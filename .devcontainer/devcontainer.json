{
  "name": "VelvetMotion AI",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "VelvetMotion Dev",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "VelvetMotion Static Preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm ci --no-audit --no-fund && npm run audit:companions",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
