{
  "name": "velvetmotion-ai",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:cloud": "node scripts/run-cloud-dev.mjs",
    "prebuild": "node scripts/generate-build-meta.mjs",
    "build": "next build",
    "preview:static": "node scripts/serve-static.mjs",
    "start": "next start",
    "lint": "next lint",
    "version:bump": "node scripts/bump-version.mjs",
    "audit:companions": "node scripts/audit-companions.mjs",
    "cloudshell": "bash scripts/cloudshell-setup.sh",
    "test": "tsx --test lib/desktopRelease.test.ts firestore.rules.test.ts lib/moodEngine.test.ts lib/penthouseSuiteLogic.test.ts lib/memoryMap.test.ts lib/safety.test.ts lib/apiRoutes.test.ts lib/studioWorkflows.test.ts && tsx scripts/validate-content.ts && node scripts/smoke-test.mjs && python3 -B -m unittest workers/test_workers.py",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules --project ivory-sunset-mxq1s",
    "deploy:rules:cloudshell": "npx -y firebase-tools@latest login --no-localhost && npm run deploy:rules",
    "deploy:auth": "npx -y firebase-tools@latest deploy --only auth --project ivory-sunset-mxq1s",
    "deploy:firebase": "npx -y firebase-tools@latest deploy --only auth,firestore:rules --project ivory-sunset-mxq1s"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@google/genai": "^3.4.0",
    "@types/three": "^0.187.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.0.0",
    "framer-motion": "^11.11.11",
    "lucide-react": "^1.74.0",
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.187.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.29",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
