rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParentOwner(userId) {
      return isOwner(userId) &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'coins', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'coins', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 60 &&
        data.coins is int && data.coins >= 0 && data.coins <= 1000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId, characterId) {
      return data.keys().hasAll(['userId', 'characterId', 'intimacy', 'gifts', 'lastMessage', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'characterId', 'intimacy', 'gifts', 'lastMessage', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.characterId is string && data.characterId.size() >= 1 && data.characterId.size() <= 128 &&
        data.characterId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.characterId == characterId &&
        data.intimacy is int && data.intimacy >= 0 && data.intimacy <= 100 &&
        data.gifts is list && data.gifts.size() <= 20 &&
        (data.gifts.size() == 0 || (data.gifts[0] is string && data.gifts[0].size() >= 1 && data.gifts[0].size() <= 60)) &&
        data.lastMessage is string && data.lastMessage.size() >= 1 && data.lastMessage.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedMedia(data, userId) {
      return data.keys().hasAll(['userId', 'characterId', 'characterName', 'mediaType', 'url', 'prompt', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'characterId', 'characterName', 'mediaType', 'url', 'prompt', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.characterId is string && data.characterId.size() >= 1 && data.characterId.size() <= 128 &&
        data.characterId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.characterName is string && data.characterName.size() >= 1 && data.characterName.size() <= 80 &&
        data.mediaType is string && data.mediaType.size() >= 1 && data.mediaType.size() <= 20 &&
        data.mediaType in ['portrait', 'lingerie', 'nude', 'explicit', 'video'] &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 2000 &&
        data.prompt is string && data.prompt.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidCustomCompanion(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'age', 'category', 'tagline', 'personality', 'figure', 'kink', 'avatar', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'name', 'age', 'category', 'tagline', 'personality', 'figure', 'kink', 'avatar', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.age is int && data.age >= 21 && data.age <= 99 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
        data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 300 &&
        data.personality is string && data.personality.size() >= 1 && data.personality.size() <= 80 &&
        data.figure is string && data.figure.size() >= 1 && data.figure.size() <= 200 &&
        data.kink is string && data.kink.size() >= 1 && data.kink.size() <= 200 &&
        data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLoungeMessage(data) {
      return data.keys().hasAll(['from', 'text', 'at', 'roomId']) &&
        data.from is string && data.from.size() >= 1 && data.from.size() <= 60 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        data.at is int &&
        data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64 &&
        (!('shareCode' in data) || (data.shareCode is string && data.shareCode.size() <= 4000));
    }

    // Assumed Data Model: /donatorLeaderboard/{entryId} (entryId == request.auth.uid)
    // Required: uid (string, immutable), username (string 1..40), totalUsd (int 0..1000000, monotonic),
    //           donationCount (int 0..10000, monotonic), favoriteGirl (string 1..40),
    //           tierTitle (string 1..80), prizeStatus (string 1..120), lastDonatedAt (int >= 0)
    // Optional: contactHandle (string <= 80), verifiedTxid (string <= 80)
    function isValidLeaderboardEntry(data, entryId) {
      return data.keys().hasAll(['uid', 'username', 'totalUsd', 'donationCount', 'favoriteGirl', 'tierTitle', 'prizeStatus', 'lastDonatedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'contactHandle', 'totalUsd', 'donationCount', 'favoriteGirl', 'tierTitle', 'prizeStatus', 'lastDonatedAt', 'verifiedTxid']) &&
        data.uid is string && data.uid == request.auth.uid && data.uid == entryId &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
        (!('contactHandle' in data) || (data.contactHandle is string && data.contactHandle.size() <= 80)) &&
        (!('verifiedTxid' in data) || (data.verifiedTxid is string && data.verifiedTxid.size() <= 80)) &&
        data.totalUsd is int && data.totalUsd >= 0 && data.totalUsd <= 1000000 &&
        data.donationCount is int && data.donationCount >= 0 && data.donationCount <= 10000 &&
        data.favoriteGirl is string && data.favoriteGirl.size() >= 1 && data.favoriteGirl.size() <= 40 &&
        data.tierTitle is string && data.tierTitle.size() >= 1 && data.tierTitle.size() <= 80 &&
        data.prizeStatus is string && data.prizeStatus.size() >= 1 && data.prizeStatus.size() <= 120 &&
        data.lastDonatedAt is int && data.lastDonatedAt >= 0;
    }

    // Assumed Data Model: /suggestions/{suggestionId}
    // Required (all fields immutable on update except votes +1):
    //   id (string == suggestionId), title (string 4..120), detail (string <= 400),
    //   category (enum), status (enum), votes (int 1..1000000), author (string 1..40), createdAt (int >= 0)
    function isValidSuggestion(data, suggestionId) {
      return data.keys().hasAll(['id', 'title', 'detail', 'category', 'status', 'votes', 'author', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'detail', 'category', 'status', 'votes', 'author', 'createdAt']) &&
        data.id is string && data.id == suggestionId &&
        data.title is string && data.title.size() >= 4 && data.title.size() <= 120 &&
        data.detail is string && data.detail.size() <= 400 &&
        data.category is string && data.category in ['Mobile & Tablet', 'AI & Video', 'Frontend', 'Backend', 'Companions'] &&
        data.status is string && data.status in ['Planned', 'In Progress', 'Live'] &&
        data.votes is int && data.votes >= 1 && data.votes <= 1000000 &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 40 &&
        data.createdAt is int && data.createdAt >= 0;
    }

    // Assumed Data Model: /users/{userId}/vault/{docId}
    // Strictly owner-isolated sync state (Memory Vault, Relationship Levels & Streaks,
    // Coin Balance snapshot, Collection metadata) for any authenticated Firebase user
    // (Email/Password, Google Sign-In, Anonymous Guest Auth).
    // Required: updatedAt (timestamp == request.time)
    // Optional: uid/userId (string == request.auth.uid == userId, immutable),
    //           id (string == docId), kind (enum), characterId (validId), schemaVersion (int 1..100),
    //           createdAt (timestamp, immutable), payload/json (string <= 65536), summary (string <= 4000),
    //           notes (string <= 8000), customPromptOverride (string <= 2000),
    //           memories/facts/longMemory/midMemory (bounded string lists),
    //           pinnedIds/vaultIds/matches/favorites/unlockedIds (bounded ID lists),
    //           xp/level/intimacy/streak/streakDays/totalMinutes/sessions/maxIntensity (bounded ints),
    //           rankTitle (string <= 80), lastActiveDate/lastClaimDate (string <= 40),
    //           unlockedMilestones (bounded int list), coins/balance (int 0..10000000),
    //           totalUsd (int 0..1000000), donationCount (int 0..10000), collectionCount (int 0..10000)
    function isValidVaultDoc(data, userId, docId) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 25 &&
        data.keys().hasAll(['updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'userId', 'id', 'kind', 'characterId', 'schemaVersion',
          'createdAt', 'updatedAt',
          'payload', 'json', 'summary', 'notes', 'customPromptOverride',
          'memories', 'facts', 'longMemory', 'midMemory',
          'pinnedIds', 'vaultIds', 'matches', 'favorites', 'unlockedIds',
          'xp', 'level', 'intimacy', 'streak', 'streakDays',
          'totalMinutes', 'sessions', 'maxIntensity', 'rankTitle',
          'lastActiveDate', 'lastClaimDate', 'unlockedMilestones',
          'coins', 'balance', 'totalUsd', 'donationCount', 'collectionCount'
        ]) &&
        (!('uid' in data) || (isValidId(data.uid) && data.uid == request.auth.uid && data.uid == userId)) &&
        (!('userId' in data) || (isValidId(data.userId) && data.userId == request.auth.uid && data.userId == userId)) &&
        (!('id' in data) || (isValidId(data.id) && data.id == docId)) &&
        (!('kind' in data) || (data.kind is string && data.kind in ['memory', 'memory_vault', 'relationship', 'progression', 'streaks', 'coins', 'wallet', 'collection', 'preferences', 'snapshot'])) &&
        (!('characterId' in data) || isValidId(data.characterId)) &&
        (!('schemaVersion' in data) || (data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        (!('payload' in data) || (data.payload is string && data.payload.size() <= 65536)) &&
        (!('json' in data) || (data.json is string && data.json.size() <= 65536)) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 4000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 8000)) &&
        (!('customPromptOverride' in data) || (data.customPromptOverride is string && data.customPromptOverride.size() <= 2000)) &&
        (!('memories' in data) || (data.memories is list && data.memories.size() <= 200 && (data.memories.size() == 0 || (data.memories[0] is string && data.memories[0].size() <= 1000)))) &&
        (!('facts' in data) || (data.facts is list && data.facts.size() <= 100 && (data.facts.size() == 0 || (data.facts[0] is string && data.facts[0].size() <= 500)))) &&
        (!('longMemory' in data) || (data.longMemory is list && data.longMemory.size() <= 50 && (data.longMemory.size() == 0 || (data.longMemory[0] is string && data.longMemory[0].size() <= 500)))) &&
        (!('midMemory' in data) || (data.midMemory is list && data.midMemory.size() <= 60 && (data.midMemory.size() == 0 || (data.midMemory[0] is string && data.midMemory[0].size() <= 500)))) &&
        (!('pinnedIds' in data) || (data.pinnedIds is list && data.pinnedIds.size() <= 200 && (data.pinnedIds.size() == 0 || isValidId(data.pinnedIds[0])))) &&
        (!('vaultIds' in data) || (data.vaultIds is list && data.vaultIds.size() <= 200 && (data.vaultIds.size() == 0 || isValidId(data.vaultIds[0])))) &&
        (!('matches' in data) || (data.matches is list && data.matches.size() <= 200 && (data.matches.size() == 0 || isValidId(data.matches[0])))) &&
        (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 200 && (data.favorites.size() == 0 || isValidId(data.favorites[0])))) &&
        (!('unlockedIds' in data) || (data.unlockedIds is list && data.unlockedIds.size() <= 200 && (data.unlockedIds.size() == 0 || isValidId(data.unlockedIds[0])))) &&
        (!('xp' in data) || (data.xp is int && data.xp >= 0 && data.xp <= 10000000)) &&
        (!('level' in data) || (data.level is int && data.level >= 1 && data.level <= 100)) &&
        (!('intimacy' in data) || (data.intimacy is int && data.intimacy >= 0 && data.intimacy <= 100)) &&
        (!('streak' in data) || (data.streak is int && data.streak >= 0 && data.streak <= 10000)) &&
        (!('streakDays' in data) || (data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000)) &&
        (!('totalMinutes' in data) || (data.totalMinutes is int && data.totalMinutes >= 0 && data.totalMinutes <= 10000000)) &&
        (!('sessions' in data) || (data.sessions is int && data.sessions >= 0 && data.sessions <= 1000000)) &&
        (!('maxIntensity' in data) || (data.maxIntensity is int && data.maxIntensity >= 0 && data.maxIntensity <= 100)) &&
        (!('rankTitle' in data) || (data.rankTitle is string && data.rankTitle.size() <= 80)) &&
        (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 40)) &&
        (!('lastClaimDate' in data) || (data.lastClaimDate is string && data.lastClaimDate.size() <= 40)) &&
        (!('unlockedMilestones' in data) || (data.unlockedMilestones is list && data.unlockedMilestones.size() <= 50 && (data.unlockedMilestones.size() == 0 || (data.unlockedMilestones[0] is int && data.unlockedMilestones[0] >= 0 && data.unlockedMilestones[0] <= 100)))) &&
        (!('coins' in data) || (data.coins is int && data.coins >= 0 && data.coins <= 10000000)) &&
        (!('balance' in data) || (data.balance is int && data.balance >= 0 && data.balance <= 10000000)) &&
        (!('totalUsd' in data) || (data.totalUsd is int && data.totalUsd >= 0 && data.totalUsd <= 1000000)) &&
        (!('donationCount' in data) || (data.donationCount is int && data.donationCount >= 0 && data.donationCount <= 10000)) &&
        (!('collectionCount' in data) || (data.collectionCount is int && data.collectionCount >= 0 && data.collectionCount <= 10000));
    }

    // Root Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'coins', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId);

      match /chats/{characterId} {
        allow get: if isValidId(userId) && isValidId(characterId) && isParentOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          isValidChatSession(incoming(), userId, characterId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentOwner(userId);

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          isValidChatSession(incoming(), userId, characterId) &&
          incoming().userId == existing().userId &&
          incoming().characterId == existing().characterId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['intimacy', 'gifts', 'lastMessage', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['intimacy', 'lastMessage', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['gifts', 'intimacy', 'updatedAt'])
          ) &&
          isParentOwner(userId);

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(characterId) && isParentOwner(userId);
      }

      match /gallery/{mediaId} {
        allow get: if isValidId(userId) && isValidId(mediaId) && isParentOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(mediaId) &&
          isValidSavedMedia(incoming(), userId) &&
          incoming().createdAt == request.time &&
          isParentOwner(userId);

        allow update: if false;

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(mediaId) && isParentOwner(userId);
      }

      match /companions/{companionId} {
        allow get: if isValidId(userId) && isValidId(companionId) && isParentOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(companionId) &&
          isValidCustomCompanion(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentOwner(userId);

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(companionId) &&
          isValidCustomCompanion(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tagline', 'personality', 'kink', 'avatar', 'updatedAt']) &&
          isParentOwner(userId);

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(companionId) && isParentOwner(userId);
      }

      // Per-user isolated sync vault for Memory Vault, Relationship Levels & Streaks,
      // Coin Balance snapshot, and Collection metadata (supports Email/Password, Google, and Anonymous Guest Auth).
      match /vault/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidVaultDoc(incoming(), userId, docId) &&
          (!('createdAt' in incoming()) || incoming().createdAt == request.time);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidVaultDoc(incoming(), userId, docId) &&
          (!('userId' in existing()) || ('userId' in incoming() && incoming().userId == existing().userId)) &&
          (!('uid' in existing()) || ('uid' in incoming() && incoming().uid == existing().uid)) &&
          (!('createdAt' in existing()) || ('createdAt' in incoming() && incoming().createdAt == existing().createdAt));

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }

    // Public lounge (Omegle-style) — signed-in users can read/write lobby messages
    match /loungeRooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        isValidLoungeMessage(incoming()) &&
        incoming().roomId == roomId &&
        incoming().text.size() <= 1000;
      allow update, delete: if false;
    }

    // Root Collection: /donatorLeaderboard/{entryId} — signed-in users can read rankings and manage their own entry
    match /donatorLeaderboard/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(entryId) &&
        entryId == request.auth.uid &&
        isValidLeaderboardEntry(incoming(), entryId);
      allow update: if isSignedIn() &&
        isValidId(entryId) &&
        entryId == request.auth.uid &&
        isValidLeaderboardEntry(incoming(), entryId) &&
        incoming().uid == existing().uid &&
        incoming().totalUsd >= existing().totalUsd &&
        incoming().donationCount >= existing().donationCount;
      allow delete: if false;
    }

    // Root Collection: /suggestions/{suggestionId} — signed-in users can read, submit (votes == 1), and upvote (+1)
    match /suggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(suggestionId) &&
        isValidSuggestion(incoming(), suggestionId) &&
        incoming().votes == 1;
      allow update: if isSignedIn() &&
        isValidId(suggestionId) &&
        isValidSuggestion(incoming(), suggestionId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['votes']) &&
        incoming().votes is int &&
        incoming().votes == existing().votes + 1 &&
        incoming().votes <= 1000000;
      allow delete: if false;
    }

    // Root Collection: /catalog/{docId} — public read-only catalog
    match /catalog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Root Collection: /dailyDrops/{docId} — public read-only daily drops
    match /dailyDrops/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Root Collection: /templates/{templateId} — public read, signed-in write
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(templateId);
    }

    // Root Collection: /groups/{groupId} — signed-in group rooms
    match /groups/{groupId} {
      allow read, write: if isSignedIn() && isValidId(groupId);
    }
  }
}
