rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParentOwner(userId) {
      return isOwner(userId) &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'coins', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'coins', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 60 &&
        data.coins is int && data.coins >= 0 && data.coins <= 1000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId, characterId) {
      return data.keys().hasAll(['userId', 'characterId', 'intimacy', 'gifts', 'lastMessage', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'characterId', 'intimacy', 'gifts', 'lastMessage', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.characterId is string && data.characterId.size() >= 1 && data.characterId.size() <= 128 &&
        data.characterId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.characterId == characterId &&
        data.intimacy is int && data.intimacy >= 0 && data.intimacy <= 100 &&
        data.gifts is list && data.gifts.size() <= 20 &&
        (data.gifts.size() == 0 || (data.gifts[0] is string && data.gifts[0].size() >= 1 && data.gifts[0].size() <= 60)) &&
        data.lastMessage is string && data.lastMessage.size() >= 1 && data.lastMessage.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedMedia(data, userId) {
      return data.keys().hasAll(['userId', 'characterId', 'characterName', 'mediaType', 'url', 'prompt', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'characterId', 'characterName', 'mediaType', 'url', 'prompt', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.characterId is string && data.characterId.size() >= 1 && data.characterId.size() <= 128 &&
        data.characterId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.characterName is string && data.characterName.size() >= 1 && data.characterName.size() <= 80 &&
        data.mediaType is string && data.mediaType.size() >= 1 && data.mediaType.size() <= 20 &&
        data.mediaType in ['portrait', 'lingerie', 'nude', 'explicit', 'video'] &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 2000 &&
        data.prompt is string && data.prompt.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidCustomCompanion(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'age', 'category', 'tagline', 'personality', 'figure', 'kink', 'avatar', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'name', 'age', 'category', 'tagline', 'personality', 'figure', 'kink', 'avatar', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.age is int && data.age >= 21 && data.age <= 99 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
        data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 300 &&
        data.personality is string && data.personality.size() >= 1 && data.personality.size() <= 80 &&
        data.figure is string && data.figure.size() >= 1 && data.figure.size() <= 200 &&
        data.kink is string && data.kink.size() >= 1 && data.kink.size() <= 200 &&
        data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLoungeMessage(data) {
      return data.keys().hasAll(['from', 'text', 'at', 'roomId']) &&
        data.from is string && data.from.size() >= 1 && data.from.size() <= 60 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        data.at is int &&
        data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64 &&
        (!('shareCode' in data) || (data.shareCode is string && data.shareCode.size() <= 4000));
    }

    // Assumed Data Model: /donatorLeaderboard/{entryId} (entryId == request.auth.uid)
    // Required: uid (string, immutable), username (string 1..40), totalUsd (int 0..1000000, monotonic),
    //           donationCount (int 0..10000, monotonic), favoriteGirl (string 1..40),
    //           tierTitle (string 1..80), prizeStatus (string 1..120), lastDonatedAt (int >= 0)
    // Optional: contactHandle (string <= 80), verifiedTxid (string <= 80)
    function isValidLeaderboardEntry(data, entryId) {
      return data.keys().hasAll(['uid', 'username', 'totalUsd', 'donationCount', 'favoriteGirl', 'tierTitle', 'prizeStatus', 'lastDonatedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'contactHandle', 'totalUsd', 'donationCount', 'favoriteGirl', 'tierTitle', 'prizeStatus', 'lastDonatedAt', 'verifiedTxid']) &&
        data.uid is string && data.uid == request.auth.uid && data.uid == entryId &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
        (!('contactHandle' in data) || (data.contactHandle is string && data.contactHandle.size() <= 80)) &&
        (!('verifiedTxid' in data) || (data.verifiedTxid is string && data.verifiedTxid.size() <= 80)) &&
        data.totalUsd is int && data.totalUsd >= 0 && data.totalUsd <= 1000000 &&
        data.donationCount is int && data.donationCount >= 0 && data.donationCount <= 10000 &&
        data.favoriteGirl is string && data.favoriteGirl.size() >= 1 && data.favoriteGirl.size() <= 40 &&
        data.tierTitle is string && data.tierTitle.size() >= 1 && data.tierTitle.size() <= 80 &&
        data.prizeStatus is string && data.prizeStatus.size() >= 1 && data.prizeStatus.size() <= 120 &&
        data.lastDonatedAt is int && data.lastDonatedAt >= 0;
    }

    // Assumed Data Model: /suggestions/{suggestionId}
    // Required (all fields immutable on update except votes +1):
    //   id (string == suggestionId), title (string 4..120), detail (string <= 400),
    //   category (enum), status (enum), votes (int 1..1000000), author (string 1..40), createdAt (int >= 0)
    function isValidSuggestion(data, suggestionId) {
      return data.keys().hasAll(['id', 'title', 'detail', 'category', 'status', 'votes', 'author', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'detail', 'category', 'status', 'votes', 'author', 'createdAt']) &&
        data.id is string && data.id == suggestionId &&
        data.title is string && data.title.size() >= 4 && data.title.size() <= 120 &&
        data.detail is string && data.detail.size() <= 400 &&
        data.category is string && data.category in ['Mobile & Tablet', 'AI & Video', 'Frontend', 'Backend', 'Companions'] &&
        data.status is string && data.status in ['Planned', 'In Progress', 'Live'] &&
        data.votes is int && data.votes >= 1 && data.votes <= 1000000 &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 40 &&
        data.createdAt is int && data.createdAt >= 0;
    }

    // Root Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'coins', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId);

      match /chats/{characterId} {
        allow get: if isValidId(userId) && isValidId(characterId) && isParentOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          isValidChatSession(incoming(), userId, characterId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentOwner(userId);

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          isValidChatSession(incoming(), userId, characterId) &&
          incoming().userId == existing().userId &&
          incoming().characterId == existing().characterId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['intimacy', 'gifts', 'lastMessage', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['intimacy', 'lastMessage', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['gifts', 'intimacy', 'updatedAt'])
          ) &&
          isParentOwner(userId);

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(characterId) && isParentOwner(userId);
      }

      match /gallery/{mediaId} {
        allow get: if isValidId(userId) && isValidId(mediaId) && isParentOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(mediaId) &&
          isValidSavedMedia(incoming(), userId) &&
          incoming().createdAt == request.time &&
          isParentOwner(userId);

        allow update: if false;

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(mediaId) && isParentOwner(userId);
      }

      match /companions/{companionId} {
        allow get: if isValidId(userId) && isValidId(companionId) && isParentOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(companionId) &&
          isValidCustomCompanion(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentOwner(userId);

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(companionId) &&
          isValidCustomCompanion(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tagline', 'personality', 'kink', 'avatar', 'updatedAt']) &&
          isParentOwner(userId);

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(companionId) && isParentOwner(userId);
      }
    }

    // Public lounge (Omegle-style) — signed-in users can read/write lobby messages
    match /loungeRooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        isValidLoungeMessage(incoming()) &&
        incoming().roomId == roomId &&
        incoming().text.size() <= 1000;
      allow update, delete: if false;
    }

    // Root Collection: /donatorLeaderboard/{entryId} — signed-in users can read rankings and manage their own entry
    match /donatorLeaderboard/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(entryId) &&
        entryId == request.auth.uid &&
        isValidLeaderboardEntry(incoming(), entryId);
      allow update: if isSignedIn() &&
        isValidId(entryId) &&
        entryId == request.auth.uid &&
        isValidLeaderboardEntry(incoming(), entryId) &&
        incoming().uid == existing().uid &&
        incoming().totalUsd >= existing().totalUsd &&
        incoming().donationCount >= existing().donationCount;
      allow delete: if false;
    }

    // Root Collection: /suggestions/{suggestionId} — signed-in users can read, submit (votes == 1), and upvote (+1)
    match /suggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(suggestionId) &&
        isValidSuggestion(incoming(), suggestionId) &&
        incoming().votes == 1;
      allow update: if isSignedIn() &&
        isValidId(suggestionId) &&
        isValidSuggestion(incoming(), suggestionId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['votes']) &&
        incoming().votes is int &&
        incoming().votes == existing().votes + 1 &&
        incoming().votes <= 1000000;
      allow delete: if false;
    }
  }
}
