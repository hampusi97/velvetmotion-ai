# All optional — site runs 100% free with Pollinations when these are empty.

# --- Images ---
# Any POST endpoint: { prompt, negative_prompt, width, height, seed } -> { url | b64_json }
# Serves adult content. Leave blank to use keyless Pollinations.
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=
# Hosted Kontext-class reference image edit endpoint ({ image, prompt, seed, strength })
AI_REFERENCE_ENDPOINT=

# --- Video ---
# Any POST endpoint: { image, prompt } -> { url | video_url }. fal.ai example below.
# AI_VIDEO_ENDPOINT=https://queue.fal.run/fal-ai/minimax/video-01
# Leave blank to use keyless Pollinations Wan, then browser animation.
AI_VIDEO_ENDPOINT=
AI_VIDEO_API_KEY=

# --- Chat ---
# Keyless Pollinations is the default. Set these to override.
AI_CHAT_ENDPOINT=
AI_CHAT_API_KEY=
XAI_API_KEY=

# Optional supporter tip links (used in 7-day dismissible Supporter Banner & Wallet)
NEXT_PUBLIC_KOFI_URL=
NEXT_PUBLIC_SUBSCRIBESTAR_URL=
