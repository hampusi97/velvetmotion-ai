# All optional — site runs 100% free with Pollinations when these are empty.

# Better chat (xAI Grok or any OpenAI-compatible endpoint)
XAI_API_KEY=
AI_CHAT_ENDPOINT=
AI_CHAT_API_KEY=

# Custom image API (otherwise Pollinations Flux)
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=

# Real MP4 video. Without this = free 4-frame Pollinations still sequences.
# fal.ai example:
#   AI_VIDEO_ENDPOINT=https://queue.fal.run/fal-ai/minimax/video-01
#   AI_VIDEO_API_KEY=your_fal_key
# Or any POST endpoint that accepts { prompt, aspect_ratio } and returns { url | video_url }.
AI_VIDEO_ENDPOINT=
AI_VIDEO_API_KEY=

# Optional supporter tip links (used in 7-day dismissible Supporter Banner & Wallet)
NEXT_PUBLIC_KOFI_URL=
NEXT_PUBLIC_SUBSCRIBESTAR_URL=
